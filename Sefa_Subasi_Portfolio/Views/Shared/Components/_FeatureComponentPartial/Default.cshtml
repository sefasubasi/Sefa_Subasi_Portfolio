<section id="home">
    <div class="container">
        <div class="row align-items-center gy-5">
            <!-- Left Column -->
            <div class="col-lg-7 reveal-on-scroll is-revealed">
                <div class="eyebrow-badge">
                    <i class="bi bi-hand-wave-fill"></i> @ViewBag.Head
                </div>

                <h1 class="hero-title">
                    @ViewBag.Subtitle
                </h1>

                <div class="typewriter-wrapper">
                    <span id="typewriterText"></span><span class="typing-cursor"></span>
                </div>

                <p class="hero-lead">
                    @ViewBag.Detail
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <a href="#projects" class="btn-sage">
                        <span>Projelerimi Keşfet</span>
                        <i class="bi bi-arrow-down-right"></i>
                    </a>
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Benimle İletişime Geç</span>
                        <i class="bi bi-chat-text"></i>
                    </a>
                </div>

                <!-- Social Links -->
                <div class="d-flex align-items-center gap-2 pt-2">
                    <span class="text-muted small me-2 font-heading fw-semibold">Takip Edebilirsiniz:</span>
                    <a href="https://github.com/sefasubasi" target="_blank" rel="noopener noreferrer" class="social-pill" title="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                    <a href="https://linkedin.com/in/sefasubasi" target="_blank" rel="noopener noreferrer" class="social-pill" title="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-5 reveal-on-scroll is-revealed">
                <div class="position-relative mx-auto" style="max-width: 440px;">
                    <div class="hero-portrait-frame">
                        <img src="@ViewBag.FeatureImgUrl"
                             alt="@ViewBag.Name - @ViewBag.Title"
                             class="hero-portrait-img">
                    </div>

                    <div class="hero-profile-info">
                        <h5>@ViewBag.Name</h5>
                        <span class="hero-profile-divider"></span>
                        <p>@ViewBag.Title</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="text-center mt-5 pt-4">
            <a href="#about" class="scroll-indicator">
                <div class="scroll-mouse">
                    <div class="scroll-dot"></div>
                </div>
                <span>Aşağı Kaydır</span>
            </a>
        </div>
    </div>
</section>
<style>
    .hero-profile-info {
        text-align: center;
        margin-top: 18px;
    }

        .hero-profile-info h5 {
            font-size: 20px;
            font-weight: 700;
            color: #292D2B;
            margin-bottom: 9px;
        }

    .hero-profile-divider {
        display: block;
        width: 38px;
        height: 2px;
        background: #91AA9D;
        margin: 0 auto 9px;
        border-radius: 2px;
    }

    .hero-profile-info p {
        font-size: 14px;
        font-weight: 500;
        color: #829D90;
        margin: 0;
        letter-spacing: .3px;
    }
</style>