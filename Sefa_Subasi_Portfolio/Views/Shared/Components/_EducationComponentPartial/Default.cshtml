@model List<Sefa_Subasi_Portfolio.DAL.Entities.Education>

<section id="education" class="bg-white border-top border-bottom py-5">
    <div class="container">
        <div class="row gy-5 justify-content-center">
            <div class="col-lg-9 text-center reveal-on-scroll">
                <div class="eyebrow-badge mx-auto">
                    <i class="bi bi-mortarboard-fill"></i> AKADEMİK YOLCULUK
                </div>
                <h2 class="section-title mb-4">
                    Eğitim Hayatım
                </h2>

                <div class="d-flex flex-column gap-4 text-start">
                    @foreach (var item in Model)
                    {
                        <div class="p-4 rounded-4 border bg-light shadow-sm">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h3 class="h5 fw-bold mb-0">@item.Title</h3>
                                <span class="badge bg-secondary-subtle text-dark">@item.Durum</span>
                            </div>
                            <div class="text-muted fw-semibold small mb-2 font-heading">
                                @item.SchoolName
                            </div>
                            <p class="text-muted small mb-0">
                                @item.Description
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>